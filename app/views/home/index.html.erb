<div class="flex h-screen w-full bg-gray-100" data-controller="vision">
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- Left Side: Upload Section -->
  <div class="w-1/2 p-6 flex flex-col items-center justify-center border-r border-gray-200 bg-gray-50">
    <div class="w-full max-w-lg">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-8 text-center text-gray-900 leading-tight tracking-tight">
        Find your UI gaps<br>
        <span class="text-indigo-600 italic">in a second!</span>
      </h1>
      
      <!-- Drop Zone -->
      <div 
        data-vision-target="dropzone" 
        data-action="dragover->vision#dragover dragleave->vision#dragleave drop->vision#drop"
        class="relative group border-4 border-dashed border-gray-300 rounded-2xl p-12 transition-all duration-200 flex flex-col items-center justify-center cursor-pointer bg-white hover:border-indigo-400 hover:bg-indigo-50"
      >
        <div class="text-center" data-action="click->vision#selectImage">
          <div class="bg-indigo-100 text-indigo-600 p-4 rounded-full mb-4 mx-auto w-fit group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-lg font-medium text-gray-700">Drag and drop your screenshot</p>
          <p class="text-sm text-gray-500 mb-6">PNG, JPG or WebP</p>
          <button 
            class="px-6 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors shadow-sm"
            data-action="click->vision#selectImage"
          >
            Select Image
          </button>
        </div>
        <input 
          type="file" 
          data-vision-target="input" 
          class="hidden" 
          accept="image/*" 
          data-action="change->vision#handleFile"
        >
      </div>

      <!-- Preview Area -->
      <div 
        data-vision-target="previewContainer" 
        class="hidden w-full max-w-lg mx-auto bg-white p-4 rounded-2xl border border-gray-200 shadow-sm"
      >
        <div class="relative group">
          <img 
            data-vision-target="preview" 
            src="" 
            alt="Preview" 
            class="w-full h-auto rounded-lg border border-gray-100 shadow-inner"
          >
          <div class="absolute top-4 right-4">
            <button 
              data-vision-target="resetButton"
              data-action="click->vision#resetImage"
              class="p-2 bg-white/90 backdrop-blur-sm text-gray-600 rounded-full hover:text-red-600 transition-colors shadow-md border border-gray-200"
              title="Change Image"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        </div>
        
        <!-- Loading State -->
        <div 
          data-vision-target="loadingState" 
          class="hidden flex flex-col items-center justify-center py-4 space-y-3"
        >
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
          <p class="text-indigo-600 font-medium text-sm">Analyzing screenshot...</p>
        </div>

        <p data-vision-target="previewCaption" class="text-center text-sm text-gray-500 mt-4 italic">Selected image ready for analysis</p>
      </div>
    </div>
  </div>

  <!-- Right Side: Expert Panel Grid -->
  <div class="w-1/2 p-6 flex flex-col bg-white overflow-y-auto">
    <h2 class="text-2xl font-bold mb-6 text-gray-800 text-center">Expert Audit Panel</h2>
    
    <!-- 2x2 Grid of Expert Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-5xl mx-auto">

      <!-- Accessibility Lead -->
      <div id="card-accessibility_lead" class="expert-card group relative p-6 rounded-2xl border-2 border-blue-100 bg-blue-50/30 transition-all duration-300 hover:border-blue-400 hover:shadow-md">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 rounded-full bg-blue-500 flex items-center justify-center text-white mr-3 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-blue-900 tracking-tight">Accessibility Lead</h3>
        </div>
        <div class="content-area text-gray-700 leading-relaxed text-sm min-h-[100px]">
          <div class="loader flex items-center space-x-2 text-blue-400 animate-pulse">
            <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
            <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
            <div class="w-2 h-2 bg-blue-400 rounded-full"></div>
            <span class="text-xs font-medium ml-1">Waiting for upload...</span>
          </div>
          <div class="result hidden"></div>
        </div>
      </div>

      <!-- Visual Architect -->
      <div id="card-visual_architect" class="expert-card group relative p-6 rounded-2xl border-2 border-purple-100 bg-purple-50/30 transition-all duration-300 hover:border-purple-400 hover:shadow-md">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 rounded-full bg-purple-500 flex items-center justify-center text-white mr-3 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9h6v6H9z" />
            </svg>
          </div>
          <h3 class="font-bold text-purple-900 tracking-tight">Visual Architect</h3>
        </div>
        <div class="content-area text-gray-700 leading-relaxed text-sm min-h-[100px]">
          <div class="loader flex items-center space-x-2 text-purple-400 animate-pulse">
            <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
            <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
            <div class="w-2 h-2 bg-purple-400 rounded-full"></div>
            <span class="text-xs font-medium ml-1">Waiting for upload...</span>
          </div>
          <div class="result hidden"></div>
        </div>
      </div>

      <!-- UX Psychologist -->
      <div id="card-ux_psychologist" class="expert-card group relative p-6 rounded-2xl border-2 border-amber-100 bg-amber-50/30 transition-all duration-300 hover:border-amber-400 hover:shadow-md">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 rounded-full bg-amber-500 flex items-center justify-center text-white mr-3 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="font-bold text-amber-900 tracking-tight">UX Psychologist</h3>
        </div>
        <div class="content-area text-gray-700 leading-relaxed text-sm min-h-[100px]">
          <div class="loader flex items-center space-x-2 text-amber-400 animate-pulse">
            <div class="w-2 h-2 bg-amber-400 rounded-full"></div>
            <div class="w-2 h-2 bg-amber-400 rounded-full"></div>
            <div class="w-2 h-2 bg-amber-400 rounded-full"></div>
            <span class="text-xs font-medium ml-1">Waiting for upload...</span>
          </div>
          <div class="result hidden"></div>
        </div>
      </div>

      <!-- Copy Specialist -->
      <div id="card-copy_specialist" class="expert-card group relative p-6 rounded-2xl border-2 border-emerald-100 bg-emerald-50/30 transition-all duration-300 hover:border-emerald-400 hover:shadow-md">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 rounded-full bg-emerald-500 flex items-center justify-center text-white mr-3 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <h3 class="font-bold text-emerald-900 tracking-tight">Copy Specialist</h3>
        </div>
        <div class="content-area text-gray-700 leading-relaxed text-sm min-h-[100px]">
          <div class="loader flex items-center space-x-2 text-emerald-400 animate-pulse">
            <div class="w-2 h-2 bg-emerald-400 rounded-full"></div>
            <div class="w-2 h-2 bg-emerald-400 rounded-full"></div>
            <div class="w-2 h-2 bg-emerald-400 rounded-full"></div>
            <span class="text-xs font-medium ml-1">Waiting for upload...</span>
          </div>
          <div class="result hidden"></div>
        </div>
      </div>

    </div>
  </div>
</div>
