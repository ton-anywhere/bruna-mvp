<div class="flex h-screen w-full bg-gray-100" data-controller="vision">
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- Left Side: Upload Section -->
  <div class="w-1/2 p-6 flex flex-col items-center justify-center border-r border-gray-200 bg-gray-50">
    <div class="w-full max-w-lg">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-8 text-center text-gray-900 leading-tight tracking-tight">
        Find your UI gaps<br>
        <span class="text-indigo-600 italic">in a second!</span>
      </h1>
      
      <!-- Drop Zone -->
      <div 
        data-vision-target="dropzone" 
        data-action="dragover->vision#dragover dragleave->vision#dragleave drop->vision#drop"
        class="relative group border-4 border-dashed border-gray-300 rounded-2xl p-12 transition-all duration-200 flex flex-col items-center justify-center cursor-pointer bg-white hover:border-indigo-400 hover:bg-indigo-50"
      >
        <div class="text-center" data-action="click->vision#selectImage">
          <div class="bg-indigo-100 text-indigo-600 p-4 rounded-full mb-4 mx-auto w-fit group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-lg font-medium text-gray-700">Drag and drop your screenshot</p>
          <p class="text-sm text-gray-500 mb-6">PNG, JPG or WebP</p>
          <button 
            class="px-6 py-2 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition-colors shadow-sm"
            data-action="click->vision#selectImage"
          >
            Select Image
          </button>
        </div>
        <input 
          type="file" 
          data-vision-target="input" 
          class="hidden" 
          accept="image/*" 
          data-action="change->vision#handleFile"
        >
      </div>

      <!-- Preview Area -->
      <div 
        data-vision-target="previewContainer" 
        class="hidden w-full max-w-lg mx-auto bg-white p-4 rounded-2xl border border-gray-200 shadow-sm"
      >
        <div class="relative group">
          <img 
            data-vision-target="preview" 
            src="" 
            alt="Preview" 
            class="w-full h-auto rounded-lg border border-gray-100 shadow-inner"
          >
          <div class="absolute top-4 right-4">
            <button 
              data-vision-target="resetButton"
              data-action="click->vision#resetImage"
              class="p-2 bg-white/90 backdrop-blur-sm text-gray-600 rounded-full hover:text-red-600 transition-colors shadow-md border border-gray-200"
              title="Change Image"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        </div>
        
        <!-- Loading State -->
        <div 
          data-vision-target="loadingState" 
          class="hidden flex flex-col items-center justify-center py-4 space-y-3"
        >
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
          <p class="text-indigo-600 font-medium text-sm">Analyzing screenshot...</p>
        </div>

        <p data-vision-target="previewCaption" class="text-center text-sm text-gray-500 mt-4 italic">Selected image ready for analysis</p>
      </div>
    </div>
  </div>

  <!-- Right Side: AI Response Placeholder -->
  <div class="w-1/2 p-6 flex flex-col items-center justify-start bg-white">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">AI Analysis</h2>
    
    <!-- AI Thinking Block -->
    <div id="vision-reasoning" class="w-full max-w-2xl mb-6 p-4 bg-gray-50 rounded-lg text-sm text-gray-500 italic border border-gray-200 hidden">
      <!-- Reasoning will be injected here -->
    </div>

    <!-- Audit Results Container -->
    <div 
      data-vision-target="auditResultsContainer" 
      class="w-full max-w-2xl space-y-6 hidden"
    >
      <!-- General Summary -->
      <div data-vision-target="summaryResult" class="p-6 bg-white rounded-xl border-l-4 border-gray-400 shadow-sm space-y-2">
        <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500">General Summary</h3>
        <div class="text-gray-700 leading-relaxed"></div>
      </div>

      <!-- Accessibility Card -->
      <div data-vision-target="accessibilityResult" class="hidden p-6 bg-white rounded-xl border-l-4 border-blue-500 shadow-sm space-y-2 transition-all">
        <h3 class="text-sm font-bold uppercase tracking-wider text-blue-600">Accessibility</h3>
        <div class="text-gray-700 leading-relaxed"></div>
      </div>

      <!-- Visual Hierarchy Card -->
      <div data-vision-target="hierarchyResult" class="hidden p-6 bg-white rounded-xl border-l-4 border-purple-500 shadow-sm space-y-2 transition-all">
        <h3 class="text-sm font-bold uppercase tracking-wider text-purple-600">Visual Hierarchy</h3>
        <div class="text-gray-700 leading-relaxed"></div>
      </div>

      <!-- UX Friction Card -->
      <div data-vision-target="frictionResult" class="hidden p-6 bg-white rounded-xl border-l-4 border-amber-500 shadow-sm space-y-2 transition-all">
        <h3 class="text-sm font-bold uppercase tracking-wider text-amber-600">UX Friction</h3>
        <div class="text-gray-700 leading-relaxed"></div>
      </div>
    </div>

    <!-- Initial Prompt -->
    <div id="vision-answer" class="w-full max-w-md p-8 border-2 border-dashed border-gray-300 rounded-lg text-center text-xl font-bold text-indigo-600">
      Upload a screenshot to see the AI response here...
    </div>
  </div>
</div>
